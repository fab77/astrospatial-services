{
  "name": "astrospatial-services",
  "version": "0.4.1-snapshot",
  "description": "Render-independent scientific service clients for astronomy, Earth observation and planetary data.",
  "type": "module",
  "main": "./lib-esm/index.js",
  "types": "./lib-esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib-esm/index.d.ts",
      "import": "./lib-esm/index.js"
    },
    "./astronomy/name-resolver": {
      "types": "./lib-esm/astronomy/name-resolver/index.d.ts",
      "import": "./lib-esm/astronomy/name-resolver/index.js"
    },
    "./package.json": "./package.json",
    "./astronomy/hips": {
      "types": "./lib-esm/astronomy/hips/index.d.ts",
      "import": "./lib-esm/astronomy/hips/index.js"
    },
    "./astronomy/tap": {
      "types": "./lib-esm/astronomy/tap/index.d.ts",
      "import": "./lib-esm/astronomy/tap/index.js"
    },
    "./earth/name-resolver": {
      "types": "./lib-esm/earth/name-resolver/index.d.ts",
      "import": "./lib-esm/earth/name-resolver/index.js"
    },
    "./earth/openstreetmap": {
      "types": "./lib-esm/earth/openstreetmap/index.d.ts",
      "import": "./lib-esm/earth/openstreetmap/index.js"
    },
    "./earth/emergency": {
      "types": "./lib-esm/earth/emergency/index.d.ts",
      "import": "./lib-esm/earth/emergency/index.js"
    },
    "./earth/wildfire": {
      "types": "./lib-esm/earth/wildfire/index.d.ts",
      "import": "./lib-esm/earth/wildfire/index.js"
    },
    "./planetary/elevation": {
      "types": "./lib-esm/planetary/elevation/index.d.ts",
      "import": "./lib-esm/planetary/elevation/index.js"
    },
    "./planetary/catalog": {
      "types": "./lib-esm/planetary/catalog/index.d.ts",
      "import": "./lib-esm/planetary/catalog/index.js"
    },
    "./planetary/node": {
      "types": "./lib-esm/planetary/node/index.d.ts",
      "import": "./lib-esm/planetary/node/index.js"
    }
  },
  "files": [
    "lib-esm/",
    "README.md",
    "LICENSE.md",
    "LICENSE-COMMERCIAL.md",
    "LICENSE-AGPL.md",
    "DEPENDENCY-LICENSING.md",
    "package.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rm -rf lib-esm",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node --test test/*.live.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Fabrizio Giordano (fab77)",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fab77/astrospatial-services.git"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "astrospatial-core": "^0.4.3"
  }
}
